server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Don't ship the git/deploy metadata files as public routes
    location ~ /\.(git|env) { deny all; }

    # Canonicalize: redirect explicit .html URLs to the extensionless version
    location = /index.html { return 301 /; }
    location ~ ^/(.+)\.html$ { return 301 /$1; }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
