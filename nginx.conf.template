server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Crawlers were treating titles as Latin-1 and misreading em dashes.
    # text/html is always included by the charset module; list the rest.
    charset utf-8;
    charset_types text/css text/javascript application/javascript application/json application/xml text/xml application/rss+xml image/svg+xml;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml text/xml application/rss+xml image/svg+xml;

    # Railway terminates TLS and proxies to this container on an internal
    # port (${PORT}), so nginx must not bake that port into redirect
    # Location headers - keep them relative (path-only).
    absolute_redirect off;

    # HSTS. Railway serves HTTPS only. Repeated in each location below that sets
    # its own add_header, because nginx drops server-level headers there.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Consolidate hosts: force www to redirect to the canonical apex domain.
    if ($host = "www.getgummygains.com") {
        return 301 https://getgummygains.com$request_uri;
    }

    # Don't ship the git/deploy metadata files as public routes
    location ~ /\.(git|env) { deny all; }

    # Canonicalize: redirect explicit .html URLs to the extensionless version.
    # IMPORTANT: match on $request_uri (the client's original URI), not on
    # location blocks. The "index index.html;" directive above performs an
    # internal rewrite of "/" to "/index.html" and re-enters location
    # matching, so a "location = /index.html { return 301 /; }" block would
    # also fire on that internal rewrite - causing every request for "/" to
    # 301-redirect to itself in an infinite loop. $request_uri is unaffected
    # by internal rewrites, so these checks only match real client requests.
    if ($request_uri ~ "^/index[.]html(?:[?]|$)") {
        return 301 /$is_args$args;
    }
    if ($request_uri ~ "^/([^?]+)[.]html(?:[?].*)?$") {
        return 301 /$1$is_args$args;
    }


    # Consolidated pages (Sept 2026) - merged into stronger pages, 301 permanently.
    location = /create-creatine-monohydrate-gummies-review { return 301 /create-creatine-gummies-review$is_args$args; }
    location = /create-creatine-for-women { return 301 /create-creatine-gummies-review$is_args$args; }
    location = /create-lemonade-collection-review { return 301 /create-creatine-gummies-review$is_args$args; }
    location = /best-creatine-electrolyte-mix { return 301 /creatine-with-electrolytes$is_args$args; }
    location = /creatine-electrolytes-vs-separate { return 301 /creatine-with-electrolytes$is_args$args; }
    location = /creatine-stick-packs-review { return 301 /creatine-gummies-vs-stick-packs$is_args$args; }
    location = /best-creatine-gummies-for-men { return 301 /best-creatine-gummies-2026$is_args$args; }
    # Search queries use this shorter path. The published page is best-creatine-gummies-for-women.
    location = /creatine-gummies-for-women { return 301 /best-creatine-gummies-for-women$is_args$args; }
    location = /creatine-gummies-for-women/ { return 301 /best-creatine-gummies-for-women$is_args$args; }

    # Consolidated October 19, 2026 - thin overlapping pages merged into stronger guides.
    location = /is-creatine-gluten-free { return 301 /gluten-free-creatine-gummies$is_args$args; }
    location = /creatine-gummies-for-powerlifting-and-strength-training { return 301 /best-creatine-gummies-for-muscle-growth$is_args$args; }
    location = /creatine-gummies-for-muscle-recovery { return 301 /best-creatine-gummies-for-muscle-growth$is_args$args; }
    location = /create-creatine-discount-code { return 301 /cheapest-way-to-buy-create-creatine$is_args$args; }
    location = /do-creatine-gummy-bundles-save-money { return 301 /cheapest-way-to-buy-create-creatine$is_args$args; }
    location = /state-of-creatine-gummies-2026 { return 301 /creatine-gummies-lab-tested$is_args$args; }
    location = /30-days-no-missed-creatine-dose { return 301 /best-time-to-take-creatine-gummies$is_args$args; }

    # Consolidated October 26, 2026 - weak overlapping pages merged into stronger pages.
    location = /bear-balanced-creatine-gummies-review { return 301 /create-vs-bear-balanced$is_args$args; }
    location = /beast-bites-creatine-gummies-review { return 301 /create-vs-beast-bites$is_args$args; }
    location = /creatine-impurities-dcd-dht { return 301 /creatine-gummies-lab-tested$is_args$args; }
    location = /creatine-for-travel { return 301 /creatine-gummies-vs-stick-packs$is_args$args; }
    location = /creatine-gummies-return-policy { return 301 /cheapest-way-to-buy-create-creatine$is_args$args; }
    location = /are-creatine-gummies-worth-it { return 301 /how-much-should-creatine-gummies-cost$is_args$args; }
    location = /best-tasting-creatine-gummies { return 301 /create-creatine-gummies-review$is_args$args; }
    location = /bounce-nutrition-creatine-gummies-review { return 301 /best-creatine-gummies-2026$is_args$args; }

    # Filenames are not hashed, so avoid year-long immutable caching.
    location ~* \.(?:css|js|mjs)$ {
        add_header Cache-Control "public, max-age=604800";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    location ~* \.(?:png|jpe?g|gif|webp|svg|ico|avif|woff2?)$ {
        add_header Cache-Control "public, max-age=2592000";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    location ~* \.(?:json|xml|txt)$ {
        add_header Cache-Control "public, max-age=3600";
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}
